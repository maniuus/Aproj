{
  "name": "aproj",
  "version": "0.1.1",
  "description": "Administrasi Proyek Konstruksi — laporan harian & rekap",
  "main": "./out/main/index.js",
  "author": "archiTech",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:ui": "node tests/ux-seed.js && playwright test tests/ui.spec.js",
    "test:flow": "node tests/ux-seed.js && playwright test tests/ui-flow.spec.js",
    "test:visual": "node tests/ux-seed.js && playwright test tests/ui-visual.spec.js",
    "test:visual:update": "node tests/ux-seed.js && playwright test tests/ui-visual.spec.js --update-snapshots",
    "test:all": "npm run typecheck && npm run build && npm run test:ui && npm run test:flow && npm run test:visual",
    "dist:win": "electron-vite build && electron-builder --win",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "pdfkit": "^0.19.1",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.4",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
